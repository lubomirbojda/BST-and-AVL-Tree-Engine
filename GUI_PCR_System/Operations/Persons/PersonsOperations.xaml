<Window x:Class="GUI_PCR_System.Operations.Persons.PersonsOperations"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI_PCR_System.Operations.Persons"
        mc:Ignorable="d"
        Title="PersonsOperations" Height="Auto" Width="Auto">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="Choose operation" HorizontalAlignment="Left" Width="180" Height="30" Margin="10" Click="ChooseOperation_Click">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Find sick persons in district at date" Click="Operation_FindSickPersonsInDistrictAtDate"/>
                    <MenuItem Header="Find sick persons in region at date" Click="Operation_FindSickPersonsInRegionAtDate"/>
                    <MenuItem Header="Find sick persons at date" Click="Operation_FindSickPersonsAtDate"/>
                    <MenuItem Header="Find one sick person with highest test value from every district at date" Click="Operation_FindOneSickPersonWithHighestValueFromEveryDistrictAtDate"/>
                    <MenuItem Header="Insert person" Click="Operation_InsertPerson"/>
                    <MenuItem Header="Delete person" Click="Operation_DeletePerson"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>

        <ListView Grid.Row="1" Margin="5" x:Name="PCRTestsListView">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="First name" DisplayMemberBinding="{Binding FirstName}" Width="150"/>
                    <GridViewColumn Header="Last name" DisplayMemberBinding="{Binding LastName}" Width="150"/>
                    <GridViewColumn Header="Birthdate" DisplayMemberBinding="{Binding BirthDate}" Width="150"/>
                    <GridViewColumn Header="Person ID" DisplayMemberBinding="{Binding PersonID}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
