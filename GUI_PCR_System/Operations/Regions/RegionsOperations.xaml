<Window x:Class="GUI_PCR_System.Operations.Regions.RegionsOperations"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI_PCR_System.Operations.Regions"
        mc:Ignorable="d"
        Title="RegionsOperations" Height="Auto" Width="Auto">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Choose operation" HorizontalAlignment="Left" Width="180" Height="30" Margin="10" Click="ChooseOperation_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Find all regions ordered by sick people count at date" Click="Operation_FindAllRegionsOrderedBySickPeopleCountAtDate"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Results count: "/>
            <TextBlock x:Name="CountTextBox" Grid.Column="2" VerticalAlignment="Center" Text="0"/>
        </Grid>

        

        <ListView Grid.Row="1" Margin="5" x:Name="RegionsListView">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Region ID" DisplayMemberBinding="{Binding RegionID}" Width="150"/>
                    <GridViewColumn Header="Count of sick people" DisplayMemberBinding="{Binding SickPeopleCount}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
