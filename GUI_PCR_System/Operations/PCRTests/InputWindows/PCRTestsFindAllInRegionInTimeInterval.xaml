<Window x:Class="GUI_PCR_System.Operations.PCRTests.InputWindows.PCRTestsFindAllInRegionInTimeInterval"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI_PCR_System.Operations.PCRTests.InputWindows"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="PCRTestsFindAllInRegionInTimeInterval" Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="From:" Margin="15"/>
        <xctk:DateTimePicker Grid.Row="0" Grid.Column="1" x:Name="DateTimePickerFrom" Margin="0,5,0,10"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="To:" Margin="15"/>
        <xctk:DateTimePicker Grid.Row="1" Grid.Column="1" x:Name="DateTimePickerTo" Margin="0,5,0,10"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Region ID:" Margin="15"/>
        <xctk:IntegerUpDown Grid.Row="2" Grid.Column="1" Margin="5" x:Name="RegionIDBox"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Only positive?" Margin="15"/>
        <CheckBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" x:Name="OnlyPositiveCheckBox"/>

        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
            <Button Content="Find" Width="80" Height="25" VerticalAlignment="Bottom" Margin="5" Click="FindButton_Click"/>
            <Button Content="Cancel" Width="80" Height="25" HorizontalAlignment="Right" Margin="5" VerticalAlignment="Bottom" Click="CancelButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
